# pnpm hoist patterns so Expo / Babel / React Native tools can resolve
# their peer dependencies at the top level of node_modules.
# Without these, Metro / Babel / Sentry may fail to find plugins that
# are installed as nested dependencies inside .pnpm/.
public-hoist-pattern[]=*babel*
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=*metro*
public-hoist-pattern[]=@sentry/*
