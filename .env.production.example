# LokShift Mobile — Production environment template.
#
# Copy this file to `.env.production` and fill in the real values before
# running `pnpm build:ios` or `pnpm build:android`. Do NOT commit the
# real `.env.production` to git.
#
# EAS Build will pick these up via the `env` block in eas.json's
# `production` profile when the matching EXPO_PUBLIC_ secret is set:
#   eas secret:create --scope project --name EXPO_PUBLIC_SUPABASE_URL --value 'https://…supabase.co'

# Production Supabase project
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROD-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ…YOUR-PROD-ANON-KEY

# Production web app URL — used for the "Open in web app" links, the
# forgot-password recovery redirect, and the Help / Support button.
EXPO_PUBLIC_WEBAPP_URL=https://app.lokshift.app

# Sentry DSN — optional. Without it, crash reporting silently no-ops.
# Get this from https://sentry.io/settings/<org>/projects/lokshift-mobile/keys/
EXPO_PUBLIC_SENTRY_DSN=https://YOUR-KEY@oXXX.ingest.sentry.io/XXX
