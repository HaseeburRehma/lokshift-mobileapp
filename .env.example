# Copy to .env (gitignored) and fill in the actual values.
# Both must match the values the webapp uses so the apps share the same
# Supabase project, RLS policies, and data.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Base URL of the deployed webapp. The mobile forgot-password flow POSTs to
# `${EXPO_PUBLIC_WEBAPP_URL}/api/auth/send-recovery` so it can reuse the
# same custom email template (link + 6-digit OTP via Resend).
EXPO_PUBLIC_WEBAPP_URL=https://your-vercel-deployment.vercel.app

# ── Crash reporting (Sentry) ─────────────────────────────────────────
# DSN for Sentry — get one at https://sentry.io → Project Settings →
# Client Keys. Leave empty in development to skip reporting; production
# builds should always have this set so client crashes surface in the
# Sentry dashboard.
#
# Setup steps the dev still has to run once:
#   1) pnpm add @sentry/react-native
#   2) fill in the DSN below
#   3) (optional, recommended for prod) run the wizard once for source
#      maps + native crash linking:  pnpm exec sentry-wizard -i reactNative
EXPO_PUBLIC_SENTRY_DSN=
